generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                      String        @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  email                   String        @unique
  password                String?
  avatar                  String?
  provider                String        @default("local")
  googleId                String?
  role                    Role          @default(user)
  status                  Status        @default(active)
  isVerified              Boolean       @default(false)
  otp                     String?
  otpExpires              DateTime?
  pushToken               String?
  points                  Int           @default(50)
  lastLoginRewardClaimedAt DateTime?
  lastTxRewardClaimedAt    DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  transactions            Transaction[]
  dues                    Due[]
  goals                   Goal[]
  investments             InvestmentProject[]
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  title     String
  amount    Float
  type      String   
  category  String  
  date      String  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Due {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  personName String
  phone      String?
  amount     Float
  type       String   // 'receivable' | 'payable'
  note       String?
  dueDate    String?
  isSettled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  name          String
  targetAmount  Float
  description   String?
  isCompleted   Boolean  @default(false)
  pointsAwarded Int
  createdAt     String
  history       SavingsLog[]
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

type SavingsLog {
  id     String
  amount Float
  date   String
  note   String?
}

model InvestmentProject {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  name         String
  targetBudget Float?
  description  String?
  createdAt    String
  logs         InvestmentLog[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

type InvestmentLog {
  id     String
  title  String
  amount Float
  date   String
}

enum Status {
  active
  inactive
  blocked
}

enum Role {
  user
  admin
}
