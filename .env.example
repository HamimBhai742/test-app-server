PORT=5000
DATABASE_URL="mongodb://localhost:27017/my_server_db"
PASSWORD_SALT=10
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="1d"
NODE_ENV="development"

# Optional SMTP Settings for sending real emails to user inbox (e.g. Gmail)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_gmail_app_password"
# SMTP_FROM='"হিসাব কিতাব" <your_email@gmail.com>'

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_oauth_client_id_here.apps.googleusercontent.com"
